# Copia este archivo como ~/luna-erp/.env en PythonAnywhere y completa los valores.
# Reemplaza TU_USUARIO por tu usuario de PythonAnywhere. No subas el .env a GitHub.

# Genera una clave nueva en la consola Bash con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=PEGAR_AQUI_UNA_CLAVE_ALEATORIA_DE_50_CARACTERES

DEBUG=false
ALLOWED_HOSTS=TU_USUARIO.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://TU_USUARIO.pythonanywhere.com
# Si usas dominio propio, agrégalo separado por coma en ALLOWED_HOSTS y en CSRF_TRUSTED_ORIGINS:
#   ALLOWED_HOSTS=TU_USUARIO.pythonanywhere.com,lunaminimarket.com.py,www.lunaminimarket.com.py
#   CSRF_TRUSTED_ORIGINS=https://TU_USUARIO.pythonanywhere.com,https://www.lunaminimarket.com.py

# El frontend se sirve desde el mismo dominio: no hace falta CORS.
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=

# HTTPS detrás del proxy de PythonAnywhere.
SECURE_SSL_REDIRECT=true
TRUST_PROXY_SSL_HEADER=true
SECURE_HSTS_SECONDS=31536000
NUM_PROXIES=1

# Base de datos (pestaña "Databases" de PythonAnywhere).
DB_ENGINE=django.db.backends.mysql
DB_NAME=TU_USUARIO$minimercado
DB_USER=TU_USUARIO
DB_PASSWORD=LA_CLAVE_DE_MYSQL_QUE_ELEGISTE_EN_DATABASES
DB_HOST=TU_USUARIO.mysql.pythonanywhere-services.com
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Datos del negocio (el ticket usa la configuración de Facturación si está cargada).
NEGOCIO_NOMBRE=Luna Minimarket
NEGOCIO_RUC=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=

LOGIN_THROTTLE_RATE=10/min
