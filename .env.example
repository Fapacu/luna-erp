# Copia este archivo a .env y reemplaza los valores de ejemplo.
# Genera SECRET_KEY con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_50_CARACTERES

# Desarrollo local. Para producción usa DEBUG=false y HTTPS.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=

DB_ENGINE=django.db.backends.mysql
DB_NAME=minimercado
DB_USER=minimercado_app
DB_PASSWORD=REEMPLAZAR_POR_LA_CLAVE_DEL_USUARIO_DE_BASE_DE_DATOS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Datos impresos en el ticket de venta
NEGOCIO_NOMBRE=Luna Minimarket
NEGOCIO_RUC=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=

# Intentos de inicio de sesión permitidos por IP
LOGIN_THROTTLE_RATE=10/min

# En producción detrás de un proxy HTTPS, ajusta esto según el proxy.
SECURE_SSL_REDIRECT=false
TRUST_PROXY_SSL_HEADER=false
SECURE_HSTS_SECONDS=0
